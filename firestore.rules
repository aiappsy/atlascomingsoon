rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Catch-All Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper Primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidSubscriber(data) {
      return data.keys().hasAll(['email', 'createdAt', 'status'])
        && data.keys().hasOnly(['email', 'createdAt', 'status', 'membershipTier', 'welcomeEmailSent', 'welcomeEmailSentAt', 'waitlistPosition'])
        && data.email is string
        && data.email.size() > 3
        && data.email.size() <= 254
        && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && data.createdAt is string
        && data.createdAt.size() <= 40
        && data.status in ['pending', 'confirmed', 'invited']
        && (!('membershipTier' in data) || (data.membershipTier is string && data.membershipTier.size() <= 64))
        && (!('welcomeEmailSent' in data) || (data.welcomeEmailSent is bool))
        && (!('welcomeEmailSentAt' in data) || (data.welcomeEmailSentAt is string && data.welcomeEmailSentAt.size() <= 40))
        && (!('waitlistPosition' in data) || (data.waitlistPosition is int && data.waitlistPosition > 0));
    }

    function isValidWelcomeEmail(data) {
      return data.keys().hasAll(['recipientEmail', 'subject', 'sentAt', 'status', 'inviteCode'])
        && data.keys().hasOnly(['recipientEmail', 'subject', 'sentAt', 'status', 'inviteCode'])
        && data.recipientEmail is string
        && data.recipientEmail.size() > 3
        && data.recipientEmail.size() <= 254
        && data.recipientEmail.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && data.subject is string
        && data.subject.size() > 0
        && data.subject.size() <= 160
        && data.sentAt is string
        && data.sentAt.size() <= 40
        && data.status in ['queued', 'sent', 'delivered']
        && data.inviteCode is string
        && data.inviteCode.size() > 0
        && data.inviteCode.size() <= 32;
    }

    // Connectivity test collection
    match /test/{docId} {
      allow get: if isValidId(docId);
      allow write: if false;
    }

    // Subscribers collection
    match /subscribers/{subscriberId} {
      allow create: if isValidId(subscriberId) && isValidSubscriber(incoming());
      allow get, list, update, delete: if false;
    }

    // Dispatched Welcome confirmation emails
    match /welcome_emails/{emailId} {
      allow create: if isValidId(emailId) && isValidWelcomeEmail(incoming());
      allow get, list, update, delete: if false;
    }
  }
}
