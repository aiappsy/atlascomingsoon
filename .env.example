# ========================================================
# ATLAS TRAVEL CLUB - ENVIRONMENT VARIABLES
# ========================================================

# --------------------------------------------------------
# 1. CLIENT-SIDE TRANSACTIONAL EMAIL (Option 1: Recommended for AI Studio)
# Works directly from static browser deployments without any backend server.
# Free signup at https://www.emailjs.com/ (200 free emails/month)
# --------------------------------------------------------
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_WELCOME_TEMPLATE_ID=

# --------------------------------------------------------
# 2. CUSTOM WEBHOOK RELAY (Alternative Option 1)
# Any HTTPS webhook endpoint (Google Apps Script, Cloudflare Worker, Resend, Zapier, Make)
# --------------------------------------------------------
VITE_EMAIL_WEBHOOK_URL=

# --------------------------------------------------------
# 3. ADMIN PORTAL SECURITY (/admin)
# --------------------------------------------------------
VITE_CRM_PASSCODE=atlas2026

# --------------------------------------------------------
# 4. LOCAL BACKEND GMAIL SMTP (Only used when running local Node server)
# --------------------------------------------------------
SENDER_EMAIL=paljuritzen@gmail.com
GMAIL_APP_PASSWORD=
